    {
      "parameters": {
        "jsCode": "const item = $json;\n\n// Clean Subject (remove \"Subject: \" prefix)\nconst rawSubject = item.subject || \"\";\nconst subject = rawSubject.replace(\"Subject: \", \"\").trim();\n\n// Clean Date (remove \"Date: \" prefix)\nconst rawDate = item.date || \"\";\nconst date = rawDate.replace(\"Date: \", \"\").trim();\n\n// Get From details\nconst fromName = item.from?.value?.[0]?.name || \"\";\nconst fromEmail = item.from?.value?.[0]?.address || \"\";\n\n// Get Body\nconst body = $input.first().json.text || \"\";\n\n// Get Message ID\n// Clean Message ID (remove < and >)\nconst id = item.id || \"\";\n\n// Get To Email\nconst toEmail = item.to?.value?.[0]?.address || \"\";\n\nreturn [{\n  json: {\n    fromName,\n    fromEmail,\n    subject,\n    body,\n    date,\n    id,\n    toEmail\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
